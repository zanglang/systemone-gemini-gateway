# Patterns to ignore when building packages.
.DS_Store
.git/
.gitignore
.vscode/
.idea/
*.swp
*.bak
*.tmp
*.orig
*~
# CI-only values and helm-unittest suites are not part of the packaged chart.
ci/
# Match only the helm-unittest suites. A bare `tests/` would also drop
# templates/tests/ (the `helm test` hook), which helmignore matches by dir name.
tests/*_test.yaml
